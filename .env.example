# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Persistent storage directory (set to a path outside the deploy directory on Hostinger)
# This prevents data-storage.json from being wiped on each deploy
# STORAGE_DIR=/home/user/persistent-data

# SMTP (contact form)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
SMTP_SECURE=false
